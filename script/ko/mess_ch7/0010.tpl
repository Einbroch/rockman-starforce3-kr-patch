@archive 0010
@size 2

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = DrGoodall
	"여기가 사이버 코어의\n세계구나… 노이즈\n웨이브라니…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"아, 굿올 박사님!\n무사하셔서 다행이에요!"
	keyWaitClearMsg
	mugshotShow
		mugshot = DrGoodall
	"아서도 이런 사이버 코어에서\n싸웠었지…"
	keyWaitClearMsg
	"나 같은 늙은이도 이 나이에\n건강하고 행복하게 살\n수 있는데…"
	keyWaitClearMsg
	"그런데 왜"
	wait15
	"."
	wait15
	"."
	wait15
	"."
	wait15
	keyWaitClearMsg
	"왜 그렇게 착한 아이가\n그런 일을 겪어야 했던 걸까…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"굿올 박사님…"
	keyWaitClearMsg
	mugshotShow
		mugshot = DrGoodall
	"그 아이를 도와주지\n못했어…"
	keyWaitClearMsg
	msgClose
	end
}
script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"바이러스다!!"
	keyWaitClearMsg
	mugshotShow
		mugshot = DrGoodall
	"록맨!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"구하러 왔어요!"
	keyWaitClearMsg
	"여기서 돌아가시면 에이스의 희생이\n아무 의미도 없잖아요!"
	keyWaitClearMsg
	mugshotShow
		mugshot = DrGoodall
	"너희는…"
	keyWaitClearMsg
	"네 말이 맞아…!"
	keyWaitClearMsg
	"아직 나도 싸움에\n보탬이 될 수 있어!"
	keyWaitClearMsg
	"날 여기서 데리고 나가\n줘, 록맨!!"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"박사님을 두고 갈 순 없어요!"
	keyWaitClearMsg
	"웨이브 배틀!\n라이드 온!!"
	keyWaitClearMsg
	msgClose
	end
}
