	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"스바루!\n와자 때처럼\n해 보자!"
	keyWaitClearMsg
	"내가 약한 부분을 부숴서\n노이즈 웨이브 안으로\n들어갈 수 있게 할게!"
	keyWaitClearMsg
	"그 안에서 그들을\n찾는 거야!"
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"좋아! 저 벽한테 누가 우두머리인지\n보여 주자!!"
	keyWaitClearMsg
	end
}
