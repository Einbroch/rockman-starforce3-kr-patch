	end
}
script 3 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = AaronBoreal
	"와… 벌써\n[Area0016]에 도착한 거야?"
	keyWaitClearMsg
	"발 빠르구나,\n스바루."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"아마치 씨, 여기에는\n상황을 알려 줄 사람이\n아무도 없어요."
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"흠, 그렇구나."
	keyWaitClearMsg
	"우리가 [Area0016]에\n대해 알아낸 건 전부\n알려 주지."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"왜 이렇게 늦었어!?"
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"거의 모든 사람이\n[Area0016]에서 빠져나왔어."
	keyWaitClearMsg
	"하지만"
	wait15
	"."
	wait15
	"."
	wait15
	"."
	wait15
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"하지만?"
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"탈출하는 혼란 속에서\n유명인 벨이\n뒤처진 모양이야."
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"벨이!?"
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"그리고 그녀를 구하려던\n스태프 리 스턴이"
	keyWaitClearMsg
	"재밍에 휘말리고\n말았지."
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"리와 벨이…"
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"아는 사람들이야?"
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"빠져나오지 못한 사람은\n그 둘뿐이야?"
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"맞아."
	keyWaitClearMsg
	"스바루, 안으로 들어가서\n그들을 구해 주겠니?"
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"물론이죠!\n저만 믿으세요!"
	keyWaitClearMsg
	mugshotShow
		mugshot = AaronBoreal
	"든든하구나."
	keyWaitClearMsg
	"사텔라 폴리스\n대원들도 보내서 널\n지원하게 하마!"
	keyWaitClearMsg
	mugshotShow
		mugshot = GeoAngry
	"알겠습니다!"
	keyWaitClearMsg
	msgClose
	end
}
