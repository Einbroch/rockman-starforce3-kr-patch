@archive 0004
@size 1

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = ApolloFlame
	mugshotDisableTalking
	"…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"너는…\n아폴론 플레임!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"얼터너티브 월드에서\n우리가 널 삭제한 줄 알았는데?"
	keyWaitClearMsg
	mugshotShow
		mugshot = ApolloFlame
	"내 데이터는\n블랙홀 서버에 저장되어 있었고,\n시리우스가 나를 복구했다."
	keyWaitClearMsg
	"나의 위대한 힘에 감탄한 그는\n나에게 협력을 요청했지."
	keyWaitClearMsg
	"나의 도덕률에 따라,\n나를 막으려는 자들을\n모두 삭제하기로 했다!"
	keyWaitClearMsg
	"하지만…\n결국 최고의 자리에 오를 자는\n바로 나다."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"이 녀석, 만만치 않겠어…\n으윽!"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"그래, 지난번에도\n꽤 강했지…"
	keyWaitClearMsg
	"하지만…"
	keyWaitClearMsg
	"아폴론 플레임!\n이것만 대답해!"
	keyWaitClearMsg
	"앞에는 뭐가 있어?"
	keyWaitClearMsg
	mugshotShow
		mugshot = ApolloFlame
	"물론 FM 성인의 별이지.\n그리고 시리우스가\n정복하고 있어."
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"그럼 널 뚫고 가서\n브라더를 구하겠어!"
	keyWaitClearMsg
	mugshotShow
		mugshot = ApolloFlame
	"아직도 이해할 만큼\n머리가 좋지 못한 건가?"
	keyWaitClearMsg
	"자연의 법칙이\n네가 여기 와서 삭제되도록\n이끈 것이다!"
	keyWaitClearMsg
	"모든 존재는\n자연의 법칙을 따라야 한다!"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"난 언제나 내 방식대로\n해! 내\n길은 내가 정한다고!"
	keyWaitClearMsg
	mugshotShow
		mugshot = ApolloFlame
	"이 은하가 어떻게\n돌아가는지 전혀 이해하지\n못하는군!"
	keyWaitClearMsg
	"직접 눈으로\n확인하게 해 주지!"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"가자, 워록!"
	keyWaitClearMsg
	"웨이브 배틀!\n라이드 온!!"
	keyWaitClearMsg
	msgClose
	end
}
