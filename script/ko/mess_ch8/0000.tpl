@archive 0000
@size 6

script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"우린 어디야?"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"처음 보는 노이즈\n웨이브 속이야."
	keyWaitClearMsg
	"뭐라고…?"
	keyWaitClearMsg
	msgClose
	end
}
script 2 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = AstroHertz
	"으윽… 우웁…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"왜 그래?"
	keyWaitClearMsg
	mugshotShow
		mugshot = AstroHertz
	"어, 어디지?"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"글쎄…\n사실 우리도 몰라."
	keyWaitClearMsg
	mugshotShow
		mugshot = AstroHertz
	"그렇구나…"
	keyWaitClearMsg
	"지구에 전해야 할\n메시지가 있어."
	keyWaitClearMsg
	"내 고향 행성에서 보낸\n구조 요청이야…"
	keyWaitClearMsg
	"모두가, 모든 것이\n곧 그 녀석에게 파괴될 거야.\n너무 강해…"
	keyWaitClearMsg
	"그리고 그 녀석의 서버도."
	wait10
	"."
	wait10
	"."
	wait30
	"\n으윽!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"이봐! 정신 차려!"
	keyWaitClearMsg
	mugshotShow
		mugshot = AstroHertz
	"더, 더는 못 가겠어…"
	keyWaitClearMsg
	"우리의 유일한 희망은\n지구에 있는 브라더야."
	keyWaitClearMsg
	"우리 왕께서 그러셨어.\n지구에 우리를 구할 힘을 가진\n사람이 있다고…"
	keyWaitClearMsg
	"으윽…"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"이봐!\n그 ‘누군가’가 누구야!?"
	keyWaitClearMsg
	"그리고 넌 어느 행성에서\n온 거야!?"
	keyWaitClearMsg
	mugshotShow
		mugshot = AstroHertz
	"나"
	wait10
	"-나는… 지…구…에…서 왔어…"
	wait15
	keyWaitClearMsg
	"우웁…"
	keyWaitClearMsg
	msgClose
	end
}
script 3 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = OmegaXis
	"젠장…\n죽어 버렸어…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"슬프지만…\n그래도 임무는\n완수했나 보네."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"뭐!\n그 말은 혹시…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
