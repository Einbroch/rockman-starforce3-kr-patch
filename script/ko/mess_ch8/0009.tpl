@archive 0009
@size 1

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"이게 블랙홀인가…"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"여긴 정말 어둡네."
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"하지만… 여긴 틀림없는\n서버야. 분위기가\n메테오 G와 아주 비슷해."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"그러고 보니…\n정말 그렇네."
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"어서!\n시리우스를 찾으러 가자!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"서버 안쪽으로\n가자!"
	keyWaitClearMsg
	"대장은 늘 뒷방에서\n기다리고 있는 법이지!"
	keyWaitClearMsg
	msgClose
	end
}
