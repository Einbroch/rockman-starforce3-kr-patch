	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"그래.\n이 웨이브 로드가\n서버 입구로 이어질 거야."
	keyWaitClearMsg
	mugshotShow
		mugshot = None
	"스바루, 나의 브라더.\n정말 와 주었구나…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"이 목소리는…!"
	wait15
	"\n세페우스, 네가 맞아!?"
	keyWaitClearMsg
	msgClose
	end
}
