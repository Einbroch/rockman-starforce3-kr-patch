script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"그래…\n드디어 도착한 거야?"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"응.\n저기가 FM 성인의 별이야."
	keyWaitClearMsg
	"그리고 시리우스의\n블랙홀 서버가…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"바로 그 위에 있어!"
	keyWaitClearMsg
	msgClose
	end
}
script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
