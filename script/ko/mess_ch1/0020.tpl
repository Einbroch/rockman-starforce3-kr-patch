@archive 0020
@size 6

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = LittleGirl
	"음, 이상하네..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"도움이 필요하니?"
	keyWaitClearMsg
	msgClose
	end
}
script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Luna
	"새로운 일이라도 생겼어, 스바루?"
	keyWaitClearMsg
	msgClose
	end
}
script 2 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"루나.\n방금 저 아이를 발견했어."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"...안녕, 루나."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"왜?"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"나만 그렇게 보이는 건가? 너,\n스바루만 따라다니는 것 같은데?"
	keyWaitClearMsg
	msgClose
	end
}
script 3 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Luna
	"뭐, 뭐라고?\n감히!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"...?"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"스바루가 누군가를 찾자마자\n네가 나타나는 게\n단순한 우연일 리는 없잖아."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"스바루는 믿음직스럽지 못하니까\n가끔씩 잘하고 있나\n확인하는 것뿐이야!"
	keyWaitClearMsg
	"스바루가 실수하면\n팀 전체가 피해를 보니까,\n실수하게 둘 수 없어!"
	keyWaitClearMsg
	"워록, 아무래도\n오해가 있는 것\n같아."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"그런가... 미안하다."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"...?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"아무튼...\n저 아이가 곤란한 일을\n겪고 있는 것 같아!"
	keyWaitClearMsg
	msgClose
	end
}
script 4 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"저기...\n무슨 일 있니?"
	keyWaitClearMsg
	"우리가 도와줄게."
	keyWaitClearMsg
	msgClose
	end
}
script 5 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = LittleGirl
	"아, 그게..."
	keyWaitClearMsg
	"친구와 싸웠는데\n그 애가 내 이메일에\n답장을 안 해."
	keyWaitClearMsg
	"아직도 나한테\n화가 난 모양이야..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"그럼 전화는 안 했어?"
	keyWaitClearMsg
	mugshotShow
		mugshot = LittleGirl
	"아니. 전화해서 화면으로\n내 얼굴을 보게 하려니\n너무 부끄러워서."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"지금 그 친구가\n어디 있는지는 아니?"
	keyWaitClearMsg
	mugshotShow
		mugshot = LittleGirl
	"아마 [Area0000]의\n공원에 있을 거야."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"스바루, 그 친구가 답장을\n하지 않는 데는\n다른 이유가 있을지도 몰라."
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"어떻게 할까, 꼬맹아?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"공원으로 가 보자!"
	keyWaitClearMsg
	msgClose
	end
}
