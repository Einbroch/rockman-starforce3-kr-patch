@archive 0028
@size 1

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"여기가 바로 [Area0012]야!?"
	keyWaitClearMsg
	"정말 멋진 곳이다.\n너무 신나!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"피디아에 따르면…"
	keyWaitClearMsg
	"“킹 재단”의\n재정 지원으로\n건설됐대."
	keyWaitClearMsg
	"아이들이 웃으며\n마음껏 아이답게 지낼 수 있는\n곳으로 만들었다고 해."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"킹 씨가 이끄는\n그 킹 재단 말이지?"
	keyWaitClearMsg
	"요즘 아버지께서\n그 사람 이야기를 자주 하셔."
	keyWaitClearMsg
	"그분과 재단은 아이들을\n행복하게 만드는 일이라면"
	keyWaitClearMsg
	"아무리 많은 돈을 써도\n아깝지 않다고 생각하신대."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"정말 대단하네…"
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"그런 게 뭐가\n중요해!?"
	keyWaitClearMsg
	"뭐 먹을 만한\n데는 없어!?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"곤타, 여기 온 목적은\n기가 에너지 카드를 얻는 거야."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"저쪽이 [Area0013]이야.\n어서 가자!"
	keyWaitClearMsg
	"토너먼트는 벌써\n시작됐어!"
	keyWaitClearMsg
	msgClose
	end
}
