@archive 0034
@size 7

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"기가 에너지 카드를 가져왔어,\n프레즈.\n자, 받아."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"와, 해냈구나, 스바루!"
	keyWaitClearMsg
	"네가 없었다면\n얻지 못했을 테니까,"
	keyWaitClearMsg
	"이걸 과학부에 전해 줄\n사람은 네가 하는\n게 좋겠어."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"그래, 좋아."
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"우후!\n학교로 돌아가자!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"과학부 사람들이\n정말 기뻐하겠지!"
	keyWaitClearMsg
	msgClose
	end
}
