script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Boy
	"*한숨*"
	keyWaitClearMsg
	mugshotShow
		mugshot = LittleBoy
	"*한숨*"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"많이 풀이 죽어 보이네.\n무슨 일일까?"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"저 애들은 신경 쓰지 마."
	keyWaitClearMsg
	"그보다 [KItem0000]을\n써 보는 게 어때?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"응? 무슨 일이야?"
	keyWaitClearMsg
	msgClose
	end
}
