	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"제법이군."
	keyWaitClearMsg
	msgClose
	end
}
script 2 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Strong
	"흥…\n이 사악한 생물들은\n끝이 없군…"
	keyWaitClearMsg
	"이걸로 100번째 삭제다…"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"100번째!?"
	keyWaitClearMsg
	"엄청 오래\n걸렸겠네!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"그런데도 전혀\n지친 기색이 없어.\n대단해."
	keyWaitClearMsg
	msgClose
	end
}
