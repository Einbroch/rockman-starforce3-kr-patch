@archive 0007
@size 6

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Strong
	"그 누구도 [Area0020]의 평화를\n어지럽히게 두지 않겠다!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"저 녀석이야…\n미소라가 말한\n그 거대한 위저드."
	keyWaitClearMsg
	mugshotShow
		mugshot = Strong
	"썩 꺼져라, 바이러스 쓰레기들!"
	keyWaitClearMsg
	"주먹의 비!"
	keyWaitClearMsg
	msgClose
	end
}
