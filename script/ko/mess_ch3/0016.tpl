	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"계속 가져와!!"
	keyWaitClearMsg
	msgClose
	bgmStop
		fadeTime = 1
	end
}
script 5 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"곤타, 바비큐는 안\n먹을 거야?\n엄청 기대했잖아..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"나 이미 먹었어!"
	keyWaitClearMsg
	"배가 엄청 불러서 잠깐 쉬는\n거야!"
	keyWaitClearMsg
	"10분 정도면 분명 다시\n배고파질 거야!!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"역시\n곤타답네."
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"아, 맞다..."
	keyWaitClearMsg
	"아직 고맙다는 말을 못 했어."
	keyWaitClearMsg
	"고마워, 스바루."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"네 셔츠 때문에?"
	keyWaitClearMsg
	"별거 아니었어."
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"그런데 스바루...\n회장님이랑 미소라가 둘 다\n지금 엄청 화났어."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"그, 그건...\n좀 무섭네..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"하하하!!"
	keyWaitClearMsg
	"넌 정말 좋은 친구야, 스바루!\n멍청한 여자애 둘보다\n남자 친구를 고르다니!"
	keyWaitClearMsg
	msgClose
	end
}
