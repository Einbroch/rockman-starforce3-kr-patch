@archive 0016
@size 12

script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Zack
	"야호!"
	keyWaitClearMsg
	"해변에서 모닥불을 피우니까\n정말 신난다!"
	keyWaitClearMsg
	"그렇지!?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Pedia
	"정말 아름다워!"
	keyWaitClearMsg
	msgClose
	end
}
script 2 mmsf3 {
	msgOpen
	bgmPlay
		bgm = 29
		fadeTime = 1
	mugshotShow
		mugshot = Zack
	"회장님, 미소라...\n와서 불꽃이 얼마나"
	keyWaitClearMsg
	"아름다운지 봐..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"*우적우적*\n*냠냠*"
	keyWaitClearMsg
	mugshotShow
		mugshot = Sonia
	"*우적우적*\n*냠냠*"
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"한 번에 그렇게 많이 먹는 건\n건강에 좋지 않아..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Pedia
	"칼로리를 제대로\n채우고 있네!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"둘 다, 조용히 해!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Sonia
	"스바루가 그럴 줄은 몰랐어...!"
	keyWaitClearMsg
	"예쁜 여자 둘보다\n남자 친구를 고르다니!"
	keyWaitClearMsg
	"뭐, 그게 스바루답긴\n하지만..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"여자로서 정말\n상처받았어!!"
	keyWaitClearMsg
	"미소라...\n쓰러질 때까지 먹자!!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Sonia
	"좋아!!"
	keyWaitClearMsg
	msgClose
	end
}
script 3 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Pedia
	"우리 안전을 위해서라도\n그냥 내버려 두자, 키자마로."
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"네 말이 맞는 것 같아..."
	keyWaitClearMsg
	"그래도 스바루가\n잘한 것 같아..."
	keyWaitClearMsg
	"여자애 중 한 명을 골랐다면\n무슨 일이 벌어졌을지\n누가 알겠어."
	keyWaitClearMsg
	mugshotShow
		mugshot = Pedia
	"선택받지 못한 아이가\n지금보다 더 화났을\n테니까..."
	keyWaitClearMsg
	"여자의 마음은 어떤\n과학 공식보다 백만\n배는 더 복잡하네..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"생각만 해도 감당이 안\n돼..."
	keyWaitClearMsg
	msgClose
	end
}
script 4 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Sonia
