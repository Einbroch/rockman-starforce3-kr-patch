@archive 0011
@size 7

script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Strong
	"으윽... 으어어...!!\n이게 무슨 카드야!?"
	keyWaitClearMsg
	"내 전파 패턴이\n다시 쓰이고 있어...!"
	keyWaitClearMsg
	mugshotShow
		mugshot = QueenTia
	"위저드를 폭주시키는\n카드다..."
	keyWaitClearMsg
	"너에게 클럽이라는 칭호를\n내려 주겠다."
	keyWaitClearMsg
	msgClose
	end
}
