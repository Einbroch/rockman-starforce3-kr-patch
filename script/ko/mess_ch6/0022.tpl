	end
}
script 7 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"시, 싫어어어어!!"
	keyWaitClearMsg
	"안 돼…"
	keyWaitClearMsg
	"안 돼애애애!!"
	keyWaitClearMsg
	msgClose
	end
}
script 8 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = MegaMan
	"모두들…"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"자, 꼬맹아…"
	keyWaitClearMsg
	"저들은 그저 자신의\n사명을 다한 것뿐이잖아?"
	keyWaitClearMsg
	mugshotShow
		mugshot = MegaMan
	"…그렇네."
	keyWaitClearMsg
	msgClose
	end
}
