@archive 0024
@size 16

script 1 mmsf3 {
	"내 브라더가 될 수\n있었다는 걸 영광으로\n생각하도록 해!"
	end
}
script 2 mmsf3 {
	"난 치즈버거가 정말정말 좋아!\n네 브라더로서, 그냥 그걸\n알려 주고 싶었어."
	end
}
script 3 mmsf3 {
	"나와 페디아는 초특급\n검색 콤비야! 우리가 답을\n찾지 못할 건 없어!"
	end
}
script 4 mmsf3 {
	"무슨 일이 있어도 우린 영원히\n브라더야!"
	end
}
script 5 mmsf3 {
	"지구의 평화를 지키는 건\n우리의 몫이야! …너무 억지로\n말한 것처럼 들리진 않았겠지."
	end
}
script 6 mmsf3 {
	"과학은 끝이 없는 길이야!\n언젠가는 훌륭한 교수가\n되고 싶어!"
	end
}
script 7 mmsf3 {
	"좋은 일을 하면 반드시\n보답을 받는 법이지."
	end
}
script 8 mmsf3 {
	"내가 아는 것이 네게\n조금이라도 도움이 된다면,\n기꺼이 힘이 되어 줄게."
	end
}
script 9 mmsf3 {
	"좋은 친구들! 좋은 시간!\n좋은 브라더! 그리고 좋은\n유대감! 오, 그래!"
	end
}
script 10 mmsf3 {
	"내가 목수였을\n때는 장난도 참\n많이 쳤었지."
	end
}
script 11 mmsf3 {
	"이번에는 아무도 답을\n알 수 없는 퀴즈를\n준비했어!"
	end
}
script 12 mmsf3 {
	"난 벨의 열렬한 팬이야!\n우후! 힘내라, 벨!"
	end
}
script 13 mmsf3 {
	"난 히비키 미소라의 열렬한 팬이야!\n미소라, 사랑해!"
	end
}
script 14 mmsf3 {
	"나는 지안 루이지야!\n고마워! 정말 큰 신세를 졌어,\n친구!"
	end
}
script 15 mmsf3 {
	"언젠가는 내 드라마를\n직접 연출해 보고 싶어!"
	end
}
