@archive 0004
@size 22

script 0 mmsf3 {
	"워록의 아머에 달린\n송곳니."
	end
}
script 1 mmsf3 {
	"강력하고 균형 잡힌\n귀걸이."
	end
}
script 2 mmsf3 {
	"차지 샷으로\n적을 잠시\n마비시키는 발톱."
	end
}
script 3 mmsf3 {
	"이 반지를 착용하면\n차지 속도가 빨라진다."
	end
}
script 4 mmsf3 {
	"차지 샷으로 적을     \n버블 상태로 만들 수 있는\n송곳니.          "
	end
}
script 5 mmsf3 {
	"눈부시게 빠른 차지 속도를\n자랑하는 귀걸이."
	end
}
script 6 mmsf3 {
	"차지 샷으로\n적을 잠시\n마비시키는 날개."
	end
}
script 7 mmsf3 {
	"초고속으로 베어 내는\n발톱."
	end
}
script 8 mmsf3 {
	"전투에서 제니만\n얻게 된다."
	end
}
script 9 mmsf3 {
	"타격력이 뛰어난\n글러브."
	end
}
script 10 mmsf3 {
	"적의 시야를 가리는\n차지 샷."
	end
}
script 11 mmsf3 {
	"극강의 타격력을 지닌\n최고급 무기."
	end
}
script 12 mmsf3 {
	"적에게 HP 버그를\n일으킬 수 있는 차지 샷."
	end
}
script 13 mmsf3 {
	"적을 혼란시키는\n차지 샷."
	end
}
script 14 mmsf3 {
	"부딪힌 패널을 깨뜨리는\n팔찌."
	end
}
script 15 mmsf3 {
	"전투에서 배틀 카드만\n얻게 된다."
	end
}
script 16 mmsf3 {
	"별의 힘을 품은\n최고급 무기."
	end
}
script 17 mmsf3 {
	"기사의 기사도\n정신이 깃든\n아이템."
	end
}
script 18 mmsf3 {
	"적을 얼릴 수 있는\n차지 샷."
	end
}
script 19 mmsf3 {
	"회오리를 일으키는\n발톱."
	end
}
script 20 mmsf3 {
	"차지 샷과 함께\n사용하면 강력하지만\n위험한 반지."
	end
}
script 21 mmsf3 {
	"전설의 영웅이 사용하는\n연사 무기."
	end
}
