@archive 0011
@size 7

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"여기가 바로\n[Area0016]이구나!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"이 나무 웨이브 로드는\nTV에서 본 적 있어!"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"어? 누가 오고 있어."
	keyWaitClearMsg
	"낯이 익은데..."
	keyWaitClearMsg
	msgClose
	end
}
script 3 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Jack
	mugshotDisableTalking
	"..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"잭이야!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"쟤가 왜 여기 있어?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Jack
	"그냥 지나가다가\n너희가 보여서."
	keyWaitClearMsg
	"혹시 나도 같이\n어울릴 수 있을까 해서... 헤헤."
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"와! 난 네가 재수 없는\n애인 줄 알았는데. 알고 보니\n꽤 괜찮은 녀석이네."
	keyWaitClearMsg
	mugshotShow
		mugshot = Jack
	mugshotDisableTalking
	"(...으.)"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"잭, 네가 원한다면\n우리랑 같이 TV에 나와도 돼!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Jack
	"나온다고?"
	keyWaitClearMsg
	"뭐에 나오는데?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"TV 프로그램에 엑스트라로\n출연하게 됐어!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Bud
	"히비키 미소라라는 스타\n알지?"
	keyWaitClearMsg
	mugshotShow
		mugshot = Zack
	"사실 우리랑\n친구야."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"오늘 TV 촬영도\n하고 콘서트도\n열릴 거야!"
	keyWaitClearMsg
	"우리랑 같이 가자, 잭!"
	keyWaitClearMsg
	msgClose
	end
}
script 4 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Jack
	mugshotDisableTalking
	"(TV 프로그램 촬영에\n 콘서트라고? 난 그런 건\n 딱 질색인데...)"
	keyWaitClearMsg
	mugshotDisableTalking
	"(누나 때문에 이런 데까지\n 끌려오다니, 정말 믿을 수가\n 없어...!!)"
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"뭐가 그렇게\n투덜거리는 거야?"
	keyWaitClearMsg
	msgClose
	end
}
script 5 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Jack
	"오! 아, 아무것도 아니야."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"그럼 어서 가자, 잭!"
	keyWaitClearMsg
	"우리 꿈이 이루어질\n시간이야!"
	keyWaitClearMsg
	mugshotShow
		mugshot = Jack
	"그건 딱히 내 꿈은\n아닌데..."
	keyWaitClearMsg
	mugshotShow
		mugshot = Luna
	"불평 그만하고\n엉덩이 좀 움직여!"
	keyWaitClearMsg
	msgClose
	end
}
script 6 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Geo
	"...정말 같이\n가 버렸네.\n괜찮을까?"
	keyWaitClearMsg
	mugshotShow
		mugshot = OmegaXis
	"너도 얼마 전까지는\n저랬잖아, 안 그래?\n한번 기회를 줘 보자."
	keyWaitClearMsg
	mugshotShow
		mugshot = Geo
	"네 말이 맞아.\n다른 애들과 함께 스튜디오로\n들어가자."
	keyWaitClearMsg
	msgClose
	end
}
