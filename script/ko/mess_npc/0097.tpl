@archive 0097
@size 16

script 0 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Noism
	"지지지직..."
	keyWaitClearMsg
	"너희가 메테오 G라 부르는 존재에\n접속하고 있다.\n지지지직..."
	keyWaitClearMsg
	msgClose
	end
}
script 1 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Noism
	"알파 베타 감마\n델타 엡실론!"
	keyWaitClearMsg
	"뉴 크시 오미크론\n파이 로 시그마!"
	keyWaitClearMsg
	"오오오... 이게 바로\n“메테오 서버”!\n접속해써어어어어!!"
	keyWaitClearMsg
	msgClose
	end
}
script 2 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Noism
	"록맨, 잘 들어..."
	keyWaitClearMsg
	"극한 상태의\n노이즈와 동기화한\n전파 생명체는"
	keyWaitClearMsg
	"궁극의 변신인\n“파이널라이즈”라는 현상을\n경험하게 돼..."
	keyWaitClearMsg
	"즉, 그 전파\n생명체는 노이즈를 지배할\n힘을 얻게 되고, 따라서"
	keyWaitClearMsg
	"노이즈 운석 메테오 G의\n서버에 접속할 수 있다는 뜻이야."
	keyWaitClearMsg
	msgClose
	end
}
script 3 mmsf3 {
	msgOpen
	mugshotShow
		mugshot = Noism
	"록맨, 잘 들어..."
	keyWaitClearMsg
	"노이즈 운석, 메테오 G는..."
	keyWaitClearMsg
	"모든 것을 집어삼킨 존재가\n만들어 낸 결과야."
	keyWaitClearMsg
	"노이즈와 우주에 존재하는\n강력한 데이터가 융합한 형태..."
	keyWaitClearMsg
	"그 엄청난 데이터\n덩어리 메테오 G는 궁극의\n서버가 되었지..."
	keyWaitClearMsg
	"「메테오 서버」 말이야."
	keyWaitClearMsg
	msgClose
	end
}
